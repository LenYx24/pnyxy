# Copy this file to .env.test (gitignored) and fill in the real
# values. Used by Playwright's auth setup to sign in once at the
# start of an e2e run.
#
# How to create the test account:
#   1. In Supabase Studio for your dev project, go to
#      Authentication → Users → Add user.
#   2. Pick an email like test@pnyxy.app and a strong password.
#      IMPORTANT: tick "Auto Confirm User" so the account skips
#      the email-confirmation step (test runs can't click links).
#   3. Paste the email + password below.
#
# When this file is absent, the authed test projects are silently
# disabled — public smoke tests still run.

TEST_USER_EMAIL=test@pnyxy.app
TEST_USER_PASSWORD=replace-me-with-a-real-password
