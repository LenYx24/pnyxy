# Secrets for local scripts. Copy to .env.local (gitignored) and fill in.
#
#   cp .env.local.example .env.local
#
# Used by:
#   pnpm import-books  — needs SUPABASE_SERVICE_ROLE_KEY (bypasses RLS)
#
# The SERVICE ROLE KEY is different from the publishable key in `.env`.
# Get it from Supabase Dashboard → Settings → API → service_role secret.
# NEVER commit it or paste it into the browser.

SUPABASE_URL=https://jneedacvujbxaiyuxuye.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here
