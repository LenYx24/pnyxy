{
  "manifest_version": 3,
  "name": "Pnyxy",
  "short_name": "Pnyxy",
  "version": "1.1.0",
  "description": "Chat with Pnyxy about the page you're reading, save it to your library, or ask about a selection.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pnyxy: chat about this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs"
  ],
  "commands": {
    "ask-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Ask Pnyxy about the current selection"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@pnyxy.com",
      "strict_min_version": "109.0"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://pnyxy.com/*",
    "https://*.pnyxy.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
