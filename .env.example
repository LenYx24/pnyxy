# Supabase project URL and publishable (anon) key.
# These defaults point at the hosted Pnyxy Supabase project. They are safe to
# commit — the publishable key is meant to be public and every table is
# protected by Row Level Security. Replace them with your own values if you
# want to run against a self-hosted Supabase.
VITE_SUPABASE_URL=https://jneedacvujbxaiyuxuye.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ImnLwX_qsn0gCW-D07lxPw_Ookz-1AE

# Lemon Squeezy hosted checkout URL for the Premium plan. Leave blank
# until the Lemon Squeezy product exists — the Plan settings tab shows a
# "coming soon" button instead of a dead link when this is unset.
# Format: https://<store>.lemonsqueezy.com/buy/<variant-uuid>
VITE_LEMONSQUEEZY_CHECKOUT_URL=
